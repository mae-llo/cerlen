# Copy this file to ".env" and fill it in. Never share or commit ".env".

# From the Discord Developer Portal: your application > Bot > Reset Token.
DISCORD_TOKEN=

# Your server's ID. In Discord: Settings > Advanced > Developer Mode on,
# then right-click your server icon > Copy Server ID.
GUILD_ID=

# Optional. Where the SQLite database and voice.json live (default: ./data).
# On the Linux server, something like /var/lib/cerlen works well.
# DATA_DIR=

# Optional. Sent to Open Library in the User-Agent, as they ask API users to do.
# CONTACT=you@example.com

# Optional. DEBUG, INFO, WARNING (default INFO).
# LOG_LEVEL=INFO
